# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne jamais committer .env (déjà exclu par .gitignore).

# --- Base de données (Supabase Postgres) ---------------------------------
# DATABASE_URL : connexion poolée (Transaction pooler, port 6543) — utilisée
# par l'application au runtime (adaptée aux fonctions serverless Vercel).
# DIRECT_URL : connexion directe (port 5432) — utilisée uniquement par les
# commandes Prisma CLI (db push, migrate, studio), nécessaire pour les
# opérations DDL qui ne passent pas par le pooler.
# Trouvables dans Supabase : Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# --- Sessions --------------------------------------------------------------
# Chaînes aléatoires longues (32+ caractères). Générer par ex. avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
ADMIN_SESSION_SECRET=""

# --- Stockage des fichiers (Supabase Storage) ------------------------------
# Project Settings > API > Project URL / service_role key (secrète, jamais
# exposée au client). Nécessite un bucket public nommé "uploads".
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Facultatif : Assistant IA commercial (chat) — DeepSeek ---------------
DEEPSEEK_API_KEY=""

# --- Facultatif : import de catalogue PDF par IA — Claude/Anthropic -------
# (analyse les images du PDF ; fonctionnalité distincte de l'assistant ci-dessus)
ANTHROPIC_API_KEY=""

# --- Facultatif : connexion Google -----------------------------------------
# Google Cloud Console > API et services > Identifiants > OAuth 2.0.
# URI de redirection autorisée : https://votre-domaine.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- E-mails transactionnels (Resend) ---------------------------------------
# resend.com > API Keys. Sert à l'e-mail de réinitialisation de mot de passe
# (lib/email.ts). Sans domaine vérifié sur Resend, EMAIL_FROM peut rester vide
# : "ZINDO <onboarding@resend.dev>" est utilisé par défaut (fonctionne pour
# tester, mais mieux vaut un domaine vérifié en production).
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Facultatif : suivi des erreurs en production (Sentry) -----------------
# sentry.io > créer un projet Next.js > Settings > Client Keys (DSN). Le DSN
# n'est pas secret (il est prévu pour être embarqué côté navigateur), mais
# tant qu'il est vide, Sentry ne capture rien — aucun impact si non défini.
NEXT_PUBLIC_SENTRY_DSN=""
# Facultatif : upload des source maps au build pour des stack traces lisibles
# (sentry.io > Settings > Auth Tokens, avec le scope "project:releases").
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
