{
  "name": "zindo",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "echo 'skipping postinstall'",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "electron:env": "node scripts/generate-electron-env.mjs",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "cross-env ELECTRON_DEV_SERVER_URL=http://localhost:3000 concurrently -k \"next dev\" \"npm:electron:build -- --watch\" \"wait-on http://localhost:3000 && electron .\"",
    "build:desktop": "cross-env ZINDO_BUILD_TARGET=desktop next build && node scripts/copy-standalone-assets.mjs",
    "electron:rebuild": "electron-builder install-app-deps",
    "electron:pack": "npm run build:desktop && npm run electron:env && npm run electron:build && npm run electron:rebuild && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.75.2",
    "@supabase/supabase-js": "^2.116.0",
    "barcode-detector": "3.2.2",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wait-on": "^8.0.2"
  }
}
