{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Compilé séparément par electron/tsconfig.json (npm run electron:build) —
    // dépend de electron/env.generated.ts, généré localement et jamais
    // commité (voir scripts/generate-electron-env.mjs), donc absent de
    // l'environnement de build Vercel. Sans cette exclusion, le contrôle
    // TypeScript de `next build` échoue sur ce fichier et bloque tout
    // déploiement, y compris pour du code sans rapport avec Electron.
    "electron"
  ]
}
